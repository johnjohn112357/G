# Copy this file to .env and replace the placeholder with a long random secret.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY=replace-with-a-generated-random-secret
# Optional: add your own OS Data Hub API key after you create/configure an OS Maps API project.
OS_MAPS_API_KEY=
HOST=0.0.0.0
PORT=8765
DB_PATH=/data/toolkit.sqlite3
